// Prisma schema for Content OS.
//
// Models every entity from the original src/lib/mock-data.ts prototype,
// migrated one page at a time onto real Prisma/Postgres queries (see
// PRODUCT_ROADMAP.md for the migration log). As of the Monetization
// migration, every page reads from this schema — mock-data.ts now only
// holds client-safe type unions (TeamRole, Platform, etc.), no data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  Free
  Pro
  Team
}

enum TeamRole {
  Owner
  Admin
  Manager
  Editor
  Moderator
  Analyst
  Viewer
}

enum MemberStatus {
  Active
  Invited
}

enum Platform {
  Instagram
  TikTok
  X
  LinkedIn
  YouTube
  Facebook
  Threads
  Pinterest
}

enum ContentStatus {
  Draft
  Scheduled
  Published
  NeedsReview @map("Needs Review")
}

enum ReviewAction {
  submitted
  approved
  changes_requested
}

enum AssetType {
  Image
  Video
  Audio
  Document
}

enum SocialStatus {
  Connected
  NotConnected @map("Not Connected")
  /// Was Connected but the token is no longer valid (simulated external
  /// revocation, or a token past its tokenExpiresAt) — distinct from a
  /// user-initiated NotConnected, since the fix here is Reconnect, not
  /// Connect (which creates a brand-new account row).
  NeedsReauth  @map("Needs Reauth")
}

enum MessageSender {
  them
  you
}

/**
 * The provider-agnostic discriminator for an inbox item — every platform
 * eventually maps its native concept (an Instagram DM, a TikTok comment,
 * an X mention, a LinkedIn notification) onto exactly one of these four,
 * so the rest of the app (list, thread view, filters) never branches on
 * platform.
 */
enum InboxItemType {
  Comment
  DirectMessage @map("Direct Message")
  Mention
  Notification
}

enum ConversationStatus {
  Open
  Resolved
}

enum MonetizationType {
  Income
  Expense
}

/**
 * The provider-agnostic discriminator for a monetization entry — a signed
 * sponsorship, an affiliate payout, ad revenue from a connected platform,
 * a merch sale, a digital product sale, misc other income, or an expense
 * all map onto exactly one of these, so summaries/timeline/filtering
 * never branch on the underlying provider. `Expense` is the only
 * non-income value; every other value's `MonetizationType` is `Income`.
 */
enum MonetizationCategory {
  Sponsorship
  Affiliate
  PlatformRevenue @map("Platform Revenue")
  Merchandise
  DigitalProduct  @map("Digital Product")
  OtherIncome     @map("Other Income")
  Expense
}

enum MonetizationStatus {
  Negotiating
  InProgress  @map("In Progress")
  Pending
  Paid
  Cancelled
}

/**
 * Where this entry's data came from. Manual is every entry today (see
 * TECH_DEBT.md) — the rest are reserved for future integrations
 * (OAuth-connected platforms' ad revenue, Stripe/Lemon Squeezy payment
 * webhooks) that would populate rows in this same shape. Adding a new
 * provider is the same additive enum extension `Platform` itself already
 * went through once (Social Accounts migration), not a schema redesign.
 */
enum MonetizationProvider {
  Manual
  YouTube
  TikTok
  Patreon
  Stripe
  LemonSqueezy @map("Lemon Squeezy")
}

model User {
  id           String                @id
  name         String
  email        String                @unique
  passwordHash String
  initials     String
  createdAt    DateTime              @default(now())
  memberships  WorkspaceMembership[]
}

model Workspace {
  id                  String                @id
  name                String
  slug                String                @unique
  plan                Plan                  @default(Free)
  initials            String
  createdAt           DateTime              @default(now())
  memberships         WorkspaceMembership[]
  content             ContentItem[]
  calendarEvents      CalendarEvent[]
  assets              Asset[]
  socialAccounts      SocialAccount[]
  conversations       Conversation[]
  monetizationEntries MonetizationEntry[]
  auditLogs           AuditLog[]
}

model WorkspaceMembership {
  id          String       @id
  userId      String
  workspaceId String
  role        TeamRole
  status      MemberStatus @default(Active)
  createdAt   DateTime     @default(now())

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs             AuditLog[]
  assignedConversations Conversation[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model ContentItem {
  id             String        @id
  workspaceId    String
  title          String
  status         ContentStatus
  platform       Platform
  scheduledAt    DateTime
  authorName     String
  authorInitials String
  body           String        @db.Text
  tags           String[]
  createdAt      DateTime      @default(now())

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets       Asset[]
  comments     ContentComment[]
  reviewEvents ReviewEvent[]
  auditLogs    AuditLog[]

  @@index([workspaceId])
}

model ContentComment {
  id             String   @id
  contentItemId  String
  author         String
  authorInitials String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

model ReviewEvent {
  id            String       @id
  contentItemId String
  action        ReviewAction
  byName        String
  byInitials    String
  note          String?      @db.Text
  createdAt     DateTime     @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

model CalendarEvent {
  id          String   @id
  workspaceId String
  scheduledAt DateTime
  title       String
  platform    Platform

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId])
}

enum AssetStatus {
  Active
  Deleted
}

/**
 * Real file metadata — storageKey/thumbnailKey point at objects in the
 * configured object storage backend (src/lib/storage), never at bytes in
 * this table. `metadata` is a deliberately open Json bucket so future
 * AI features (transcripts, embeddings, extracted labels, dimensions)
 * can attach derived data to an asset without another migration.
 */
model Asset {
  id           String      @id
  workspaceId  String
  name         String
  type         AssetType
  folder       String
  tags         String[]
  storageKey   String
  thumbnailKey String?
  mimeType     String
  byteSize     Int
  status       AssetStatus @default(Active)
  deletedAt    DateTime?
  metadata     Json?
  createdAt    DateTime    @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content   ContentItem[]
  auditLogs AuditLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

/**
 * OAuth is simulated end-to-end (see TECH_DEBT.md) — scopes/tokenExpiresAt
 * are populated with plausible fake values on connect/reconnect rather
 * than a real provider handshake, but the shape matches what a real
 * integration would store, so swapping in real OAuth later is additive.
 */
model SocialAccount {
  id             String       @id
  workspaceId    String
  platform       Platform
  handle         String
  displayName    String
  avatarUrl      String?
  followersLabel String
  status         SocialStatus
  scopes         String[]
  tokenExpiresAt DateTime?
  connectedSince DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId])
}

/**
 * A unified inbox item — a DM thread, a comment thread, a mention, or a
 * notification — from any platform. `externalId` + `metadata` exist so a
 * real provider integration can plug in later purely by populating rows
 * in this same shape (an idempotency key to dedup webhook redelivery,
 * and a free-form bucket for whatever a given platform's payload looks
 * like) rather than requiring a schema change; nothing reads `metadata`
 * yet.
 */
model Conversation {
  id                     String             @id
  workspaceId            String
  platform               Platform
  type                   InboxItemType      @default(DirectMessage)
  contactName            String
  contactHandle          String
  contactInitials        String
  externalId             String?
  status                 ConversationStatus @default(Open)
  unread                 Boolean            @default(false)
  archived               Boolean            @default(false)
  assignedToMembershipId String?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo WorkspaceMembership? @relation(fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  messages   InboxMessage[]
  notes      ConversationNote[]
  auditLogs  AuditLog[]

  @@index([workspaceId])
  @@index([workspaceId, archived])
  @@index([workspaceId, status])
  // Covers the default (archived: false, no other filter) conversation-list
  // query's exact WHERE + ORDER BY — the most common shape hit on every
  // Inbox page load — so it's a single index scan instead of a filter
  // followed by a separate sort step.
  @@index([workspaceId, archived, updatedAt])
  @@index([assignedToMembershipId])
}

model InboxMessage {
  id             String        @id
  conversationId String
  from           MessageSender
  body           String        @db.Text
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/**
 * Internal, team-only annotation on a conversation — never sent to the
 * contact, distinct from InboxMessage (the actual back-and-forth with
 * them). Same shape as ContentComment: free-text author fields, since
 * the audit trail (actorId, a real FK) is what's authoritative for who
 * did what, not this display-only author name.
 */
model ConversationNote {
  id             String   @id
  conversationId String
  authorId       String
  authorName     String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/**
 * A single revenue or expense line item — a sponsorship deal, an
 * affiliate payout, platform ad revenue, a merch sale, a digital product
 * sale, misc other income, or an expense. `externalId` + `metadata` exist
 * so a real provider integration (a Stripe payment, a YouTube AdSense
 * payout) can populate rows in this same shape later without a schema
 * migration — nothing reads `metadata` yet, matching the same pattern
 * used for `SocialAccount` and `Conversation`.
 */
model MonetizationEntry {
  id               String               @id
  workspaceId      String
  type             MonetizationType
  category         MonetizationCategory
  provider         MonetizationProvider @default(Manual)
  platform         Platform?
  title            String
  counterpartyName String?
  description      String?              @db.Text
  status           MonetizationStatus   @default(Pending)
  /// Always the entry's own currency (see `currency`) — no cross-currency conversion happens anywhere (see TECH_DEBT.md).
  amount           Decimal              @db.Decimal(12, 2)
  /// ISO 4217 code. Validated against a small curated list in the action layer, not a DB enum — new currencies never need a migration.
  currency         String               @default("USD")
  /// The date this entry is attributed to for summaries/timeline grouping — independent of dueDate/paidAt, since either may be unset.
  date             DateTime             @default(now())
  dueDate          DateTime?
  paidAt           DateTime?
  externalId       String?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, category])
  @@index([workspaceId, status])
  @@index([workspaceId, date])
}

enum AuditAction {
  ContentSubmitted
  ContentApproved
  ContentChangesRequested
  ContentCommented
  CalendarEventCreated
  CalendarEventUpdated
  CalendarEventRescheduled
  CalendarEventDeleted
  TeamMemberInvited
  TeamMemberRoleChanged
  TeamMemberRemoved
  AssetUploaded
  AssetRenamed
  AssetTagsChanged
  AssetMoved
  AssetDeleted
  AssetRestored
  SocialAccountConnected
  SocialAccountDisconnected
  SocialAccountReconnected
  SocialAccountRenamed
  SocialAccountStatusChanged
  ConversationMarkedRead
  ConversationMarkedUnread
  ConversationArchived
  ConversationUnarchived
  ConversationAssigned
  ConversationNoteAdded
  ConversationResolved
  ConversationReopened
  ConversationReplied
  MonetizationEntryCreated
  MonetizationEntryUpdated
  MonetizationEntryStatusChanged
  MonetizationEntryDeleted
}

/**
 * Immutable record of who did what and when, independent of the
 * mutable domain rows (ContentItem.status, ContentComment) the UI
 * renders. Nothing reads this yet — it exists so approvals, rejections,
 * status changes, and comments all have a durable trail from day one.
 */
model AuditLog {
  id                    String      @id
  workspaceId           String
  contentItemId         String?
  calendarEventId       String?
  workspaceMembershipId String?
  assetId               String?
  socialAccountId       String?
  conversationId        String?
  monetizationEntryId   String?
  actorId               String
  actorName             String
  action                AuditAction
  metadata              Json?
  createdAt             DateTime    @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem         ContentItem?         @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  calendarEvent       CalendarEvent?       @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  workspaceMembership WorkspaceMembership? @relation(fields: [workspaceMembershipId], references: [id], onDelete: SetNull)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  socialAccount       SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  conversation        Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  monetizationEntry   MonetizationEntry?   @relation(fields: [monetizationEntryId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contentItemId])
  @@index([calendarEventId])
  @@index([workspaceMembershipId])
  @@index([assetId])
  @@index([socialAccountId])
  @@index([conversationId])
  @@index([monetizationEntryId])
}
