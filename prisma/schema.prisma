// Prisma schema for Content OS.
//
// Models every entity from the original src/lib/mock-data.ts prototype,
// migrated one page at a time onto real Prisma/Postgres queries (see
// PRODUCT_ROADMAP.md for the migration log). As of the Social Accounts
// migration, only Inbox and Monetization still read from mock-data.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  Free
  Pro
  Team
}

enum TeamRole {
  Owner
  Admin
  Manager
  Editor
  Moderator
  Analyst
  Viewer
}

enum MemberStatus {
  Active
  Invited
}

enum Platform {
  Instagram
  TikTok
  X
  LinkedIn
  YouTube
  Facebook
  Threads
  Pinterest
}

enum ContentStatus {
  Draft
  Scheduled
  Published
  NeedsReview @map("Needs Review")
}

enum ReviewAction {
  submitted
  approved
  changes_requested
}

enum AssetType {
  Image
  Video
  Audio
  Document
}

enum SocialStatus {
  Connected
  NotConnected @map("Not Connected")
  /// Was Connected but the token is no longer valid (simulated external
  /// revocation, or a token past its tokenExpiresAt) — distinct from a
  /// user-initiated NotConnected, since the fix here is Reconnect, not
  /// Connect (which creates a brand-new account row).
  NeedsReauth @map("Needs Reauth")
}

enum MessageSender {
  them
  you
}

enum DealStatus {
  Negotiating
  InProgress @map("In Progress")
  Signed
  Paid
  Completed
}

model User {
  id           String              @id
  name         String
  email        String              @unique
  passwordHash String
  initials     String
  createdAt    DateTime            @default(now())
  memberships  WorkspaceMembership[]
}

model Workspace {
  id             String              @id
  name           String
  slug           String              @unique
  plan           Plan                @default(Free)
  initials       String
  createdAt      DateTime            @default(now())
  memberships    WorkspaceMembership[]
  content        ContentItem[]
  calendarEvents CalendarEvent[]
  assets         Asset[]
  socialAccounts SocialAccount[]
  conversations  Conversation[]
  deals          Deal[]
  auditLogs      AuditLog[]
}

model WorkspaceMembership {
  id          String       @id
  userId      String
  workspaceId String
  role        TeamRole
  status      MemberStatus @default(Active)
  createdAt   DateTime     @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model ContentItem {
  id             String    @id
  workspaceId    String
  title          String
  status         ContentStatus
  platform       Platform
  scheduledAt    DateTime
  authorName     String
  authorInitials String
  body           String    @db.Text
  tags           String[]
  createdAt      DateTime  @default(now())

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets       Asset[]
  comments     ContentComment[]
  reviewEvents ReviewEvent[]
  auditLogs    AuditLog[]

  @@index([workspaceId])
}

model ContentComment {
  id             String   @id
  contentItemId  String
  author         String
  authorInitials String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

model ReviewEvent {
  id            String       @id
  contentItemId String
  action        ReviewAction
  byName        String
  byInitials    String
  note          String?      @db.Text
  createdAt     DateTime     @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

model CalendarEvent {
  id          String   @id
  workspaceId String
  scheduledAt DateTime
  title       String
  platform    Platform

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId])
}

enum AssetStatus {
  Active
  Deleted
}

/**
 * Real file metadata — storageKey/thumbnailKey point at objects in the
 * configured object storage backend (src/lib/storage), never at bytes in
 * this table. `metadata` is a deliberately open Json bucket so future
 * AI features (transcripts, embeddings, extracted labels, dimensions)
 * can attach derived data to an asset without another migration.
 */
model Asset {
  id           String      @id
  workspaceId  String
  name         String
  type         AssetType
  folder       String
  tags         String[]
  storageKey   String
  thumbnailKey String?
  mimeType     String
  byteSize     Int
  status       AssetStatus @default(Active)
  deletedAt    DateTime?
  metadata     Json?
  createdAt    DateTime    @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content   ContentItem[]
  auditLogs AuditLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

/**
 * OAuth is simulated end-to-end (see TECH_DEBT.md) — scopes/tokenExpiresAt
 * are populated with plausible fake values on connect/reconnect rather
 * than a real provider handshake, but the shape matches what a real
 * integration would store, so swapping in real OAuth later is additive.
 */
model SocialAccount {
  id             String       @id
  workspaceId    String
  platform       Platform
  handle         String
  displayName    String
  avatarUrl      String?
  followersLabel String
  status         SocialStatus
  scopes         String[]
  tokenExpiresAt DateTime?
  connectedSince DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId])
}

model Conversation {
  id              String   @id
  workspaceId     String
  platform        Platform
  contactName     String
  contactHandle   String
  contactInitials String
  unread          Boolean  @default(false)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  InboxMessage[]

  @@index([workspaceId])
}

model InboxMessage {
  id             String        @id
  conversationId String
  from           MessageSender
  body           String        @db.Text
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Deal {
  id          String     @id
  workspaceId String
  brand       String
  title       String
  valueLabel  String
  status      DealStatus
  dueDate     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum AuditAction {
  ContentSubmitted
  ContentApproved
  ContentChangesRequested
  ContentCommented
  CalendarEventCreated
  CalendarEventUpdated
  CalendarEventRescheduled
  CalendarEventDeleted
  TeamMemberInvited
  TeamMemberRoleChanged
  TeamMemberRemoved
  AssetUploaded
  AssetRenamed
  AssetTagsChanged
  AssetMoved
  AssetDeleted
  AssetRestored
  SocialAccountConnected
  SocialAccountDisconnected
  SocialAccountReconnected
  SocialAccountRenamed
  SocialAccountStatusChanged
}

/**
 * Immutable record of who did what and when, independent of the
 * mutable domain rows (ContentItem.status, ContentComment) the UI
 * renders. Nothing reads this yet — it exists so approvals, rejections,
 * status changes, and comments all have a durable trail from day one.
 */
model AuditLog {
  id                    String   @id
  workspaceId           String
  contentItemId         String?
  calendarEventId       String?
  workspaceMembershipId String?
  assetId               String?
  socialAccountId       String?
  actorId               String
  actorName             String
  action                AuditAction
  metadata              Json?
  createdAt             DateTime @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem         ContentItem?         @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  calendarEvent       CalendarEvent?       @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  workspaceMembership WorkspaceMembership? @relation(fields: [workspaceMembershipId], references: [id], onDelete: SetNull)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  socialAccount       SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([contentItemId])
  @@index([calendarEventId])
  @@index([workspaceMembershipId])
  @@index([assetId])
  @@index([socialAccountId])
}
