DATABASE_URL="postgresql://contentos:contentos_dev_password@localhost:5432/content_os?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Asset storage (src/lib/storage). Leave unset to use the local-disk
# backend (files under .storage/, dev/test only). Set all four to switch
# to Cloudflare R2 (or any S3-compatible bucket via a different endpoint).
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="..."
